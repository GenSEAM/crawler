;; Package Grammar & Exported Symbol Registry (ASN)
;; @genseam/asl-crawler
(:grammar
  :package @genseam/asl-crawler
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    ;; 1-Token Symbols (Baseline)
    (:sym :name "StealthKind" :kind :type :tokens 1)
    (:sym :name "StealthProfile" :kind :type :tokens 1)
    (:sym :name "BrowserKind" :kind :type :tokens 1)
    (:sym :name "BrowserCandidate" :kind :type :tokens 1)
    (:sym :name "CrawlJob" :kind :type :tokens 1)
    (:sym :name "CrawlResult" :kind :type :tokens 1)
    (:sym :name "CrawlPool" :kind :type :tokens 1)

    ;; 2-Token Symbols (Compact Primary API)
    (:sym :name "googlebot-profile" :kind :fn :tokens 2)
    (:sym :name "chrome-profile" :kind :fn :tokens 2)
    (:sym :name "safari-profile" :kind :fn :tokens 2)
    (:sym :name "curl-headers" :kind :fn :tokens 2)
    (:sym :name "macos-browsers" :kind :fn :tokens 2)
    (:sym :name "linux-browsers" :kind :fn :tokens 2)
    (:sym :name "cdp-args" :kind :fn :tokens 2)
    (:sym :name "crawl-ok" :kind :fn :tokens 2)
    (:sym :name "crawl-err" :kind :fn :tokens 2)
    (:sym :name "status-ok?" :kind :fn :tokens 2)
    (:sym :name "curl-args" :kind :fn :tokens 2)
    (:sym :name "crawl-doc" :kind :fn :tokens 2)
    (:sym :name "crawl-asn" :kind :fn :tokens 2)
    (:sym :name "make-pool" :kind :fn :tokens 2)
    (:sym :name "pool-jobs" :kind :fn :tokens 2)
    (:sym :name "stealth-googlebot" :kind :fn :tokens 2)
    (:sym :name "stealth-chrome" :kind :fn :tokens 2)
    (:sym :name "stealth-safari" :kind :fn :tokens 2)
    (:sym :name "stealth-mobile" :kind :fn :tokens 2)
    (:sym :name "make-profile" :kind :fn :tokens 2)
    (:sym :name "build-headers" :kind :fn :tokens 2)
    (:sym :name "kind-chrome" :kind :fn :tokens 2)
    (:sym :name "kind-brave" :kind :fn :tokens 2)
    (:sym :name "kind-edge" :kind :fn :tokens 2)
    (:sym :name "kind-safari" :kind :fn :tokens 2)
    (:sym :name "kind-chromium" :kind :fn :tokens 2)
    (:sym :name "make-candidate" :kind :fn :tokens 2)
    (:sym :name "crawl-job" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)

    ;; >2 Token Legacy Compatibility Aliases (with :rationale)
    (:sym :name "make-crawl-job" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for crawl-job")
    (:sym :name "make-googlebot-profile" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for googlebot-profile")
    (:sym :name "make-chrome-profile" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for chrome-profile")
    (:sym :name "make-safari-profile" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for safari-profile")
    (:sym :name "format-curl-header-args" :kind :fn :tokens 4
          :rationale "Legacy compatibility alias for curl-headers")
    (:sym :name "get-macos-candidates" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for macos-browsers")
    (:sym :name "get-linux-candidates" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for linux-browsers")
    (:sym :name "build-cdp-launch-args" :kind :fn :tokens 4
          :rationale "Legacy compatibility alias for cdp-args")
    (:sym :name "make-success-result" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for crawl-ok")
    (:sym :name "make-failure-result" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for crawl-err")
    (:sym :name "build-curl-fetch-args" :kind :fn :tokens 4
          :rationale "Legacy compatibility alias for curl-args")
    (:sym :name "is-successful-status" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for status-ok?")
    (:sym :name "crawl-to-doc" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for crawl-doc")
    (:sym :name "crawl-to-asn" :kind :fn :tokens 3
          :rationale "Legacy compatibility alias for crawl-asn")
  ])

